# Runtime / base application
NODE_ENV=development
# Docker build-time Node major; Dockerfile defaults to 24.
NODE_VERSION=24
HOST=0.0.0.0
PORT=3000
ADMIN_API_KEY=replace-with-at-least-24-random-characters
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:3000

# CORS_ORIGINS is the canonical variable. ALLOWED_ORIGINS remains a backward-compatible alias.
CORS_ORIGINS=http://localhost:3000
ALLOWED_ORIGINS=

# Embeddings and vector store. The shipped Supabase migration is vector(128).
EMBEDDING_PROVIDER=local
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SUPABASE_VECTOR_DIMENSIONS=128
VECTOR_PROVIDER=local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Chat LLM: local needs no remaining LLM settings.
LLM_PROVIDER_TYPE=local
LLM_PROVIDER_NAME=local
# For any OpenAI-compatible service, set all three and a secret:
# LLM_PROVIDER_TYPE=openai-compatible
# LLM_PROVIDER_NAME=openai-compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY_ENV=LLM_API_KEY
LLM_API_KEY=
LLM_TEMPERATURE=0
# LLM_TOP_P=1
# LLM_MAX_TOKENS=1024
LLM_STREAM=false
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=250
LLM_CHAT_PATH=/chat/completions
LLM_HEALTH_PATH=/models
LLM_QUERY_PARAMS={}
LLM_AUTH_HEADER_NAME=authorization
LLM_AUTH_SCHEME=Bearer
LLM_HEADERS={}

# Diagnostics default OFF. When set to 1, only bounded metadata/counters are logged;
# customer prompts, retrieved text, answers, and stack traces are excluded.
ORBIT_RAG_DIAGNOSTICS=0

# Legacy temporary debug selectors retained for deployment compatibility.
# They are not used to enable content logging and must not contain secrets.
ORBIT_TEMP_DEBUG_CLIENT_ID=
ORBIT_TEMP_DEBUG_GOUSTO=
ORBIT_TEMP_DEBUG_LLM_INPUT=
ORBIT_TEMP_DEBUG_PUREGYM=

# Database and persistence providers
DATABASE_PROVIDER=sqlite
# Optional override; defaults to DATABASE_PROVIDER
# REPOSITORY_PROVIDER=sqlite
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A Supabase anon key is NOT accepted by this server-side application as a service-role substitute.
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=knowledge
SUPABASE_OUTBOX_TABLE=notifications

# Notifications
NOTIFICATION_PROVIDER=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Reserved for a TTS integration; no TTS provider is wired in this build.
TTS_API_KEY=

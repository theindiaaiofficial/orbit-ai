services:
  app:
    build:
      context: .
      args:
        NODE_VERSION: ${NODE_VERSION:-24}
    restart: unless-stopped
    environment:
      NODE_ENV: production
      NODE_VERSION: ${NODE_VERSION:-24}
      HOST: ${HOST:-0.0.0.0}
      PORT: ${PORT:-3000}
      ADMIN_API_KEY: ${ADMIN_API_KEY:?set ADMIN_API_KEY}
      DATA_DIR: /app/data
      PUBLIC_BASE_URL: ${PUBLIC_BASE_URL:-http://localhost:3000}
      CORS_ORIGINS: ${CORS_ORIGINS:-${ALLOWED_ORIGINS:-}}
      ALLOWED_ORIGINS: ${ALLOWED_ORIGINS:-}
      DATABASE_PROVIDER: ${DATABASE_PROVIDER:-sqlite}
      REPOSITORY_PROVIDER: ${REPOSITORY_PROVIDER:-${DATABASE_PROVIDER:-sqlite}}
      STORAGE_PROVIDER: ${STORAGE_PROVIDER:-local}
      VECTOR_PROVIDER: ${VECTOR_PROVIDER:-qdrant}
      EMBEDDING_PROVIDER: ${EMBEDDING_PROVIDER:-local}
      SUPABASE_VECTOR_DIMENSIONS: ${SUPABASE_VECTOR_DIMENSIONS:-128}
      OPENAI_BASE_URL: ${OPENAI_BASE_URL:-https://api.openai.com/v1}
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
      EMBEDDING_API_KEY: ${EMBEDDING_API_KEY:-}
      OPENAI_EMBEDDING_MODEL: ${OPENAI_EMBEDDING_MODEL:-text-embedding-3-small}
      EMBEDDING_MODEL: ${EMBEDDING_MODEL:-}
      QDRANT_URL: ${QDRANT_URL:-http://qdrant:6333}
      QDRANT_API_KEY: ${QDRANT_API_KEY:-}
      SUPABASE_URL: ${SUPABASE_URL:-}
      SUPABASE_SERVICE_ROLE_KEY: ${SUPABASE_SERVICE_ROLE_KEY:-}
      SUPABASE_ANON_KEY: ${SUPABASE_ANON_KEY:-}
      SUPABASE_STORAGE_BUCKET: ${SUPABASE_STORAGE_BUCKET:-knowledge}
      SUPABASE_OUTBOX_TABLE: ${SUPABASE_OUTBOX_TABLE:-notifications}
      LLM_PROVIDER_TYPE: ${LLM_PROVIDER_TYPE:-local}
      LLM_PROVIDER_NAME: ${LLM_PROVIDER_NAME:-local}
      LLM_BASE_URL: ${LLM_BASE_URL:-}
      LLM_MODEL: ${LLM_MODEL:-}
      LLM_API_KEY_ENV: ${LLM_API_KEY_ENV:-LLM_API_KEY}
      LLM_API_KEY: ${LLM_API_KEY:-}
      AZURE_OPENAI_API_KEY: ${AZURE_OPENAI_API_KEY:-}
      LLM_CHAT_PATH: ${LLM_CHAT_PATH:-/chat/completions}
      LLM_HEALTH_PATH: ${LLM_HEALTH_PATH:-/models}
      LLM_QUERY_PARAMS: '${LLM_QUERY_PARAMS:-}'
      LLM_AUTH_HEADER_NAME: ${LLM_AUTH_HEADER_NAME:-authorization}
      LLM_AUTH_SCHEME: ${LLM_AUTH_SCHEME:-Bearer}
      LLM_TEMPERATURE: ${LLM_TEMPERATURE:-0}
      LLM_TOP_P: ${LLM_TOP_P:-}
      LLM_MAX_TOKENS: ${LLM_MAX_TOKENS:-}
      LLM_STREAM: ${LLM_STREAM:-false}
      LLM_TIMEOUT_MS: ${LLM_TIMEOUT_MS:-15000}
      LLM_MAX_RETRIES: ${LLM_MAX_RETRIES:-2}
      LLM_RETRY_BASE_MS: ${LLM_RETRY_BASE_MS:-250}
      LLM_HEADERS: '${LLM_HEADERS:-}'
      ORBIT_RAG_DIAGNOSTICS: ${ORBIT_RAG_DIAGNOSTICS:-0}
      ORBIT_TEMP_DEBUG_CLIENT_ID: ${ORBIT_TEMP_DEBUG_CLIENT_ID:-}
      ORBIT_TEMP_DEBUG_GOUSTO: ${ORBIT_TEMP_DEBUG_GOUSTO:-}
      ORBIT_TEMP_DEBUG_LLM_INPUT: ${ORBIT_TEMP_DEBUG_LLM_INPUT:-}
      ORBIT_TEMP_DEBUG_PUREGYM: ${ORBIT_TEMP_DEBUG_PUREGYM:-}
      TTS_API_KEY: ${TTS_API_KEY:-}
      NOTIFICATION_PROVIDER: ${NOTIFICATION_PROVIDER:-outbox}
      SMTP_HOST: ${SMTP_HOST:-}
      SMTP_PORT: ${SMTP_PORT:-587}
      SMTP_USER: ${SMTP_USER:-}
      SMTP_PASS: ${SMTP_PASS:-}
      SMTP_FROM: ${SMTP_FROM:-}
    volumes: [app-data:/app/data]
    ports: ['3000:3000']
    depends_on: [qdrant]
    read_only: true
    tmpfs: [/tmp]
    security_opt: [no-new-privileges:true]
  qdrant:
    image: qdrant/qdrant:v1.14.1
    restart: unless-stopped
    volumes: [qdrant-data:/qdrant/storage]
volumes: { app-data: {}, qdrant-data: {} }
